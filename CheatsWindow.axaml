<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TMGSSaveEditor.Core.CheatsWindow"
        Title="Cheats Menu"
        Width="350" Height="800"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource MainTextFont}"/>
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ColorAppTextOnBackground}"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{DynamicResource ButtonFont}"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
    </Window.Styles>

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="15">
            <TextBlock Text="CHEATS" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            
            <Button Name="ButtonUnlockAllClothes" Classes="GenBtn" Content="UNLOCK ALL CLOTHES" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ButtonUnlockAllClothes_Click"/>
            <Button Name="ButtonMaxStats" Classes="GenBtn" Content="MAX ALL STATS" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ButtonMaxStats_Click"/>
            <Button Name="ButtonMaxMoney" Classes="GenBtn" Content="MAX MONEY" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ButtonMaxMoney_Click"/>
            <Button Name="ButtonNoStress" Classes="GenBtn" Content="NO STRESS" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ButtonNoStress_Click"/>
            
            <!--<Separator Margin="0,10,0,10" Background="{DynamicResource ColorBorderMain}"/>-->

            <Button Name="ButtonMaxAffection" Classes="GuyBtn" Content="MAX ALL GUYS' AFFECTION" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ButtonMaxAffection_Click"/>

            <TextBlock Text="Specific Guy Affection" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            
            <ComboBox Name="ComboApproachCharSelect" HorizontalAlignment="Stretch" />
            
            <Button Name="ButtonMaxAffectionSpecific" Classes="GuyBtn" Content="MAX GUY AFFECTION" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ButtonMaxAffectionSpecific_Click"/>
            
            <!--<Separator Margin="0,10,0,10" Background="{DynamicResource ColorBorderMain}"/>-->

            <Button Name="ButtonMaxFriendAffection" Classes="FriendBtn" Content="MAX ALL FRIENDS' AFFECTION" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ButtonMaxFriendAffection_Click"/>
            
            <TextBlock Text="Specific Friend Affection" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            
            <ComboBox Name="ComboFriendCharSelect" HorizontalAlignment="Stretch"/>
            
            <Button Name="ButtonMaxFriendAffectionSpecific" Classes="FriendBtn" Content="MAX FRIEND AFFECTION" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ButtonMaxFriendAffectionSpecific_Click"/>

        </StackPanel>
    </ScrollViewer>
</Window>