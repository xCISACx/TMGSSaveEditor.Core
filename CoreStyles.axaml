    <!--SCROLL BAR THUMB-->

    <Style Selector="ScrollBar:not(:pointerover) /template/ Track > Thumb /template/ Border">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFill}" />
    </Style>

    <Style Selector="ScrollBar:pointerover /template/ Track > Thumb /template/ Border">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFill}" />
    </Style>

    <Style Selector="ScrollBar /template/ Track > Thumb:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillPointerOver}" />
    </Style>

    <Style Selector="ScrollBar /template/ Track > Thumb:pressed /template/ Border">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillPressed}" />
    </Style>
</Styles>